<div class="container mt-5 py-5 text-center" style="max-width: 600px;">
    <div class="display-4 text-danger mb-3">
        <i class="bi bi-exclama-triangle"></i>
    </div>
    
    <h2 class="fw-bold">Access Denied</h2>
    <p class="text-muted mb-4">You do not have permission to view this resource.</p>

    <hr class="my-4 w-25 mx-auto">

    @if (User?.Identity?.IsAuthenticated ?? false)
    {
        <p class="mb-4">
            Signed in as <strong>@User.Identity.Name</strong>.<br>
            <small class="text-secondary">Try switching accounts or contact your admin.</small>
        </p>
        
        <div class="hstack gap-2 justify-content-center">
            <a href="/home" class="btn btn-outline-dark">Return Home</a>
            <a href="/profile/manage" class="btn btn-link">Manage Account</a>
        </div>
    }
    else
    {
        <p class="mb-4">Please sign in with an authorized account.</p>
        
        <div class="hstack gap-2 justify-content-center">
            <a href="/Account/Login" class="btn btn-primary px-4">Sign In</a>
            <a href="/home" class="btn btn-light border">Home</a>
        </div>
    }
</div>